# logs — runtime output, may contain request paths and model names
*.log
gateway.out.log

# local-only tooling: reads/patch the local editor install, not published
patch-cursor.mjs
cursor-state.mjs
local-actions.mjs

# local runtime state (holds your API key)
config.json

# local screenshots / scratch
.preview/

# local backups of patched application bundles
*.orig-*
*.bak-*
state.vscdb*
*.vsix

# misc
node_modules/
Thumbs.db
desktop.ini

# panel build output + renderer scratch (both reproducible: npm run build / python render.py)
panel/dist/
tools/render-bg/.frames/
